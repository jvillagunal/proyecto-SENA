<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.grigori.app.ui.auth.LoginFragment"
        android:label="login_fragment" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.grigori.app.ui.auth.RegisterFragment"
        android:label="register_fragment" >
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.grigori.app.ui.dashboard.DashboardFragment"
        android:label="dashboard_fragment" >
        <action
            android:id="@+id/action_dashboardFragment_to_newProblemFragment"
            app:destination="@id/newProblemFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/newProblemFragment"
        android:name="com.grigori.app.ui.newproblem.NewProblemFragment"
        android:label="new_problem_fragment" >
        <action
            android:id="@+id/action_newProblemFragment_to_solutionFragment"
            app:destination="@id/solutionFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.grigori.app.ui.history.HistoryFragment"
        android:label="history_fragment" >
        <action
            android:id="@+id/action_historyFragment_to_solutionFragment"
            app:destination="@id/solutionFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.grigori.app.ui.profile.ProfileFragment"
        android:label="profile_fragment" />

    <fragment
        android:id="@+id/solutionFragment"
        android:name="com.grigori.app.ui.solution.SolutionFragment"
        android:label="solution_fragment">
        <argument
            android:name="problemId"
            app:argType="integer" />
    </fragment>
</navigation>
