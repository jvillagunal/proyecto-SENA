<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══ Tema principal ══ -->
    <style name="Theme.GrigoriPerelmanApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryVariant">@color/accent_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <!-- ══ Fila de botones ══ -->
    <style name="BtnRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- ══ Dígito — gris oscuro ══ -->
    <style name="BtnDigit" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/btn_digit_bg</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
        <item name="cornerRadius">50dp</item>
    </style>

    <!-- ══ Función — gris claro ══ -->
    <style name="BtnFunction" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_function</item>
        <item name="backgroundTint">@color/btn_function_bg</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
        <item name="cornerRadius">50dp</item>
    </style>

    <!-- ══ Operador — naranja ══ -->
    <style name="BtnOperator" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/btn_operator_bg</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
        <item name="cornerRadius">50dp</item>
    </style>

    <!-- ══ Igual — naranja más intenso ══ -->
    <style name="BtnEquals" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/accent_orange</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">4dp</item>
        <item name="cornerRadius">50dp</item>
    </style>

</resources>
